---
import HubPage from '../../components/HubPage.astro';
const cards = [
  { icon:'lightning', category:'Available now · calculator', title:'Mining Electricity Cost Calculator', description:'Estimate energy use and electricity cost from your measured power, runtime and own tariff.', href:'/tools/electricity-cost-calculator/', status:'Available' },
  { icon:'chartLineUp', category:'Available now · scenario calculator', title:'Monero Mining Profitability Calculator', description:'Estimate pool-adjusted expected rewards and electricity-only operating balance from your own assumptions.', href:'/tools/monero-mining-profitability-calculator/', status:'Available' },
  { icon:'magnifyingGlass', category:'Available now · local diagnostic', title:'XMRig Log Decoder', description:'Interpret a bounded set of XMRig signals in this browser without uploading the pasted log.', href:'/tools/xmrig-log-decoder/', status:'Available' },
  { icon:'gauge', category:'Unit converter', title:'Hashrate unit converter', description:'Translate common hashrate units while keeping the source value and precision visible.' },
  { icon:'cpu', category:'Scenario estimate', title:'CPU mining scenario', description:'Explore a range of outcomes from explicit inputs, with uncertainty visible throughout.' },
] as const;
---
<HubPage kind="tools" title="Monero mining tools — Ember" description="A manual mining profitability estimate, electricity cost calculator and local XMRig log decoder, plus planned tools." kicker="INSTRUMENTS / 04" heading="Small tools for better-informed decisions." intro="Tools should make an assumption easier to inspect, not turn uncertainty into a confident-looking answer. Estimate pool-adjusted expected rewards from your own scenario assumptions, estimate electricity from your own measurements, or inspect a bounded set of XMRig log signals locally." index="04" indexLabel="CALCULATE / CONVERT / INSPECT" featureTitle="An answer is only as useful as its assumptions." featureCopy="The profitability calculator uses manual mining, network, reward and price inputs; it retrieves no live data. The electricity calculator uses your power draw, runtime and manually entered rate. The log decoder recognizes a limited set of explicit XMRig signals; unknown lines remain uninterpreted." featureAside="Calculations run in your browser. Calculator inputs are not uploaded or saved by the tools." cardsTitle="Available tools and planned instruments" cards={cards} note="Planned concepts will be built after their calculations, privacy boundaries and technical review criteria are defined." />
