---
import HubPage from '../../components/HubPage.astro';
const cards = [
  { icon:'lightning', category:'Available now · calculator', title:'Mining Electricity Cost Calculator', description:'Estimate energy use and electricity cost from your measured power, runtime and own tariff.', href:'/tools/electricity-cost-calculator/', status:'Available' },
  { icon:'magnifyingGlass', category:'Available now · local diagnostic', title:'XMRig Log Decoder', description:'Interpret a bounded set of XMRig signals in this browser without uploading the pasted log.', href:'/tools/xmrig-log-decoder/', status:'Available' },
  { icon:'gauge', category:'Unit converter', title:'Hashrate unit converter', description:'Translate common hashrate units while keeping the source value and precision visible.' },
  { icon:'cpu', category:'Scenario estimate', title:'CPU mining scenario', description:'Explore a range of outcomes from explicit inputs, with uncertainty visible throughout.' },
  { icon:'magnifyingGlass', category:'Log analysis · future expansion', title:'Broader XMRig log coverage', description:'Additional diagnostic signals may be added only when their meaning can be supported by upstream evidence.' },
] as const;
---
<HubPage kind="tools" title="Monero mining tools — Ember" description="An electricity cost calculator and local XMRig log decoder, plus planned mining tools." kicker="INSTRUMENTS / 04" heading="Small tools for better-informed decisions." intro="Tools should make an assumption easier to inspect, not turn uncertainty into a confident-looking answer. Estimate electricity from your own measurements, or inspect a bounded set of XMRig log signals locally." index="04" indexLabel="CALCULATE / CONVERT / INSPECT" featureTitle="An answer is only as useful as its assumptions." featureCopy="The electricity calculator uses your power draw, runtime and manually entered rate. The log decoder recognizes a limited set of explicit XMRig signals; unknown lines remain uninterpreted." featureAside="The decoder runs in your browser. Pasted log contents are not uploaded or saved by the tool." cardsTitle="Available tools and planned instruments" cards={cards} note="Planned concepts will be built after their calculations, privacy boundaries and technical review criteria are defined." />
