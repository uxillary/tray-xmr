---
import HubPage from '../../components/HubPage.astro';
const cards = [
  { icon:'lightning', category:'Available now · calculator', title:'Mining Electricity Cost Calculator', description:'Estimate energy use and electricity cost from your measured power, runtime and own tariff.', href:'/tools/electricity-cost-calculator/', status:'Available' },
  { icon:'gauge', category:'Unit converter', title:'Hashrate unit converter', description:'Translate common hashrate units while keeping the source value and precision visible.' },
  { icon:'cpu', category:'Scenario estimate', title:'CPU mining scenario', description:'Explore a range of outcomes from explicit inputs, with uncertainty visible throughout.' },
  { icon:'magnifyingGlass', category:'Local diagnostic', title:'XMRig message helper', description:'A future local-first aid for interpreting common log lines without uploading them.' },
] as const;
---
<HubPage kind="tools" title="Monero mining tools — Ember" description="A practical electricity cost calculator plus planned mining unit converters and local helpers." kicker="INSTRUMENTS / 04" heading="Small tools for better-informed decisions." intro="Tools should make an assumption easier to inspect, not turn uncertainty into a confident-looking answer. Start with an electricity estimate based on your own measurements and tariff." index="04" indexLabel="CALCULATE / CONVERT / INSPECT" featureTitle="An answer is only as useful as its assumptions." featureCopy="The electricity calculator uses your power draw, runtime and manually entered rate. It estimates energy and electricity cost only; it does not forecast mining rewards or profitability." featureAside="No tool implies guaranteed profitability. The planned local log helper will not upload logs by default." cardsTitle="Tools and planned instruments" cards={cards} note="Planned concepts will be built after their calculations, privacy boundaries and technical review criteria are defined." />
