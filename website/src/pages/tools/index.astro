---
import HubPage from '../../components/HubPage.astro';
const cards = [
  { icon: 'lightning', category: '01 / Energy', title: 'Electricity cost calculator', description: 'Understand the running cost of a measured workload.', input: 'Whole-system wall power, runtime and your tariff', output: 'Estimated energy use and electricity cost', href: '/tools/electricity-cost-calculator/', status: 'Available', actionLabel: 'Calculate electricity cost', presentation: 'tool', help: { href: '/tools/electricity-cost-calculator/#power-note-title', label: 'Which power value should I enter?' } },
  { icon: 'chartLineUp', category: '02 / Economics', title: 'Mining profitability calculator', description: 'Explore a manual scenario with its assumptions in view.', input: 'Mining, network, reward, price and electricity assumptions', output: 'Expected-value revenue and electricity-only operating balance', href: '/tools/monero-mining-profitability-calculator/', status: 'Available', actionLabel: 'Build a mining scenario', presentation: 'tool', help: { href: '/tools/monero-mining-profitability-calculator/#input-sources', label: 'Where can I get the scenario inputs?' } },
  { icon: 'magnifyingGlass', category: '03 / Diagnostics', title: 'XMRig log decoder', description: 'Make a bounded set of console signals easier to read.', input: 'A pasted XMRig output excerpt', output: 'Supported signal explanations and possible next checks', href: '/tools/xmrig-log-decoder/', status: 'Available', actionLabel: 'Decode a log', presentation: 'tool', help: { href: '/tools/xmrig-log-decoder/#decoder-scope', label: 'What can the decoder tell me?' } },
  { icon: 'gauge', category: 'Unit converter', title: 'Hashrate unit converter', description: 'Translate common hashrate units while retaining the source precision.' },
  { icon: 'cpu', category: 'Scenario estimate', title: 'CPU mining scenario', description: 'Explore a range of outcomes from explicit inputs and uncertainty.' },
] as const;
---
<HubPage kind="tools" title="Monero mining tools — Ember" description="A manual mining profitability estimate, electricity cost calculator and local XMRig log decoder, plus planned tools." kicker="INSTRUMENTS / 04" heading="Small tools. Clearer decisions." intro="Calculate from your own inputs, or inspect XMRig signals locally. Nothing is uploaded or saved. No live mining or price data." resourcesTitle="Choose a tool" resourcesNote="Three tools available now" {cards} note="Future instruments need defined calculations, privacy boundaries and technical review before publication." />
