---
import HubPage from '../../components/HubPage.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.section === 'troubleshoot')).sort((a, b) => a.data.publishedDate.valueOf() - b.data.publishedDate.valueOf());
const cards = [
  { icon:'network', category:'Network · pool', title:'Pool connection problems', description:'Separate host, port, TLS and pool-side symptoms without exposing wallet details.' },
  { icon:'shieldCheck', category:'Windows · security', title:'Security alert about a miner', description:'Review what a detection says and the safe options for deciding what to do next.' },
] as const;
---
<HubPage kind="troubleshoot" title="Monero mining troubleshooting — Ember" description="Evidence-led guidance for XMRig Huge Pages, MSR errors and low RandomX hashrate on Windows." kicker="DIAGNOSTICS / 03" heading="Read the signal before changing the system." intro="Troubleshooting starts by separating a symptom from its possible causes. These Windows and XMRig guides explain what each observation can and cannot tell you." index="03" indexLabel="OBSERVE / NARROW / VERIFY" featureTitle="A symptom is a starting point, not a diagnosis." featureCopy="The first diagnostic collection covers Huge Pages allocation, MSR setup and low hashrate with sourced checks rather than one-click fixes." featureAside="Ember does not disable security tools, create exclusions, elevate to bypass a block or restore quarantined files." cardsTitle="More diagnostic topics" cards={cards} articles={articles} note="Additional diagnostics will be published after sourcing and technical review." />
