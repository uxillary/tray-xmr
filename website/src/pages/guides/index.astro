---
import HubPage from '../../components/HubPage.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.section === 'guides')).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const cards = [
  { icon:'steps', category:'Before you begin', title:'Understand the machine and its limits', description:'Plan for resource use, heat, electricity cost and an explicit way to stop.' },
  { icon:'shieldCheck', category:'Setup choices', title:'Wallet, pool and CPU profile', description:'Review the information each choice requires and how it affects a mining session.' },
  { icon:'playCircle', category:'Operate', title:'Review, start and stop with care', description:'A careful session workflow that separates setup review from active mining.' },
] as const;
---
<HubPage kind="guides" title="Windows XMRig setup guide — Ember" description="Follow a sourced standalone XMRig setup guide for Windows, from the official release to reading first-session signals safely." kicker="WORKSHOP / 02" heading="A good guide explains the decision, too." intro="Practical walkthroughs should leave the reader more capable, not dependent on unexplained commands or copied settings." index="02" indexLabel="PREPARE / CONFIGURE / OPERATE" featureTitle="Start with standalone XMRig on Windows." featureCopy="The published walkthrough covers the official Windows build, a small local config and a foreground first run. Ember-specific steps remain separate from the general miner instructions." featureAside="No blanket administrator instructions, unknown executables or unexplained pool credentials." cardsTitle="A guide path, in order" cards={cards} articles={articles} note="One sourced setup guide is published. Other guide themes remain planned until their steps and platform details are verified." />
