---
import HubPage from '../../components/HubPage.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.section === 'guides')).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const cards = [
  { icon:'steps', category:'Before you begin', title:'Understand the machine and its limits', description:'Plan for resource use, heat, electricity cost and an explicit way to stop.' },
  { icon:'shieldCheck', category:'Setup choices', title:'Wallet, pool and CPU profile', description:'Review the information each choice requires and how it affects a mining session.' },
  { icon:'playCircle', category:'Operate', title:'Review, start and stop with care', description:'A careful session workflow that separates setup review from active mining.' },
] as const;
---
<HubPage kind="guides" title="Windows XMRig guides — Ember" description="Sourced Windows XMRig guidance for safely checking downloads, configuring a standalone miner and reading first-session signals." kicker="WORKSHOP / 02" heading="A good guide explains the decision, too." intro="Practical walkthroughs should leave the reader more capable, not dependent on unexplained commands or copied settings." index="02" indexLabel="VERIFY / CONFIGURE / OPERATE" featureTitle="Check the source before the first run." featureCopy="Published Windows resources explain release verification and a separate standalone XMRig setup path. Ember-specific product information stays separate from general miner instructions." featureAside="No blanket administrator instructions, unknown executables or unexplained pool credentials." cardsTitle="A guide path, in order" cards={cards} articles={articles} note="Windows safety and setup resources are sourced independently; check version-specific guidance before following release steps." />
