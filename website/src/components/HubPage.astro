---
import SiteLayout from './SiteLayout.astro';
import ResourceCard from './ResourceCard.astro';
import HubVisual from './HubVisual.astro';
import type { Props as Card } from './ResourceCard.astro';

interface PublishedArticle {
  id: string;
  data: { title: string; summary: string; section: 'learn' | 'guides' | 'troubleshoot'; visual: 'huge-pages' | 'msr' | 'hashrate' | 'threads' | 'memory' | 'setup' | 'security' };
}
interface Resource extends Card { help?: { href: string; label: string }; }
interface Props {
  title: string;
  description: string;
  kind: 'learn' | 'guides' | 'troubleshoot' | 'tools';
  kicker: string;
  heading: string;
  intro: string;
  resourcesTitle: string;
  resourcesNote: string;
  cards: readonly Resource[];
  articles?: PublishedArticle[];
  articleCards?: Record<string, Partial<Card>>;
  note: string;
}
const { title, description, kind, kicker, heading, intro, resourcesTitle, resourcesNote, cards, articles = [], articleCards = {}, note } = Astro.props;
const articleResources: Resource[] = articles.map((article) => ({
  title: article.data.title,
  description: article.data.summary,
  category: 'Published guide',
  icon: article.data.visual === 'security' ? 'shieldCheck' : article.data.visual === 'setup' ? 'steps' : article.data.visual === 'memory' ? 'hardDrives' : article.data.visual === 'threads' ? 'cpu' : article.data.visual === 'huge-pages' ? 'memory' : article.data.visual === 'msr' ? 'lockKey' : 'gauge',
  ...articleCards[article.id],
  href: `/${article.data.section}/${article.id}/`,
}));
const available = [...articleResources, ...cards.filter((card) => card.href)];
const planned = cards.filter((card) => !card.href);
---
<SiteLayout title={title} description={description}>
  <div class={`wrap hub-page hub-${kind}`}>
    <header class="hub-intro">
      <span class="page-kicker">{kicker}</span>
      <h1>{heading}</h1>
      <p>{intro}</p>
    </header>

    <section class="hub-resources" aria-labelledby="resources-title">
      <div class="hub-catalog-heading">
        <h2 id="resources-title">{resourcesTitle}</h2>
        <p>{resourcesNote}</p>
      </div>
      <div class="hub-resource-grid">
        {available.map(({ help, ...card }) => <div class:list={['hub-resource-item', { 'hub-companion': card.presentation === 'companion' }]}>
          <ResourceCard {...card} />
          {help && <p class="hub-resource-help"><a href={help.href}>{help.label} <span aria-hidden="true">↗</span></a></p>}
        </div>)}
      </div>
    </section>

    {(kind === 'learn' || kind === 'troubleshoot') && <HubVisual kind={kind} />}
    {Astro.slots.has('handoff') && <aside class="hub-handoff"><slot name="handoff" /></aside>}

    {planned.length > 0 && <section class="hub-future" aria-labelledby="future-title">
      <div class="hub-catalog-heading"><h2 id="future-title">Planned topics</h2><p>Not available yet</p></div>
      <div class="hub-future-grid">{planned.map((card) => <ResourceCard {...card} />)}</div>
      <p class="hub-footnote">{note}</p>
    </section>}
  </div>
</SiteLayout>
