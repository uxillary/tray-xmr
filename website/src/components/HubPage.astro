---
import SiteLayout from './SiteLayout.astro';
import ResourceCard from './ResourceCard.astro';
import HubVisual from './HubVisual.astro';
interface Card { category: string; title: string; description: string; icon: 'bookOpenText' | 'books' | 'graduationCap' | 'network' | 'memory' | 'hardDrives' | 'cpu' | 'gauge' | 'circuitry' | 'thermometer' | 'wrench' | 'shieldCheck' | 'steps' | 'lightning' | 'chartLineUp' | 'magnifyingGlass' | 'lockKey' | 'playCircle'; href?: string; status?: string; }
interface PublishedArticle { id: string; data: { title: string; summary: string; section: 'learn' | 'guides' | 'troubleshoot'; visual: 'huge-pages' | 'msr' | 'hashrate' | 'threads' | 'memory' | 'setup'; }; }
interface Props { title: string; description: string; kind: 'learn' | 'guides' | 'troubleshoot' | 'tools'; kicker: string; heading: string; intro: string; index: string; indexLabel: string; featureTitle: string; featureCopy: string; featureAside: string; cardsTitle: string; cards: readonly Card[]; note: string; articles?: PublishedArticle[]; }
const { title, description, kind, kicker, heading, intro, index, indexLabel, featureTitle, featureCopy, featureAside, cardsTitle, cards, note, articles = [] } = Astro.props as Props;
---
<SiteLayout title={title} description={description}>
  <div class={`wrap hub-page hub-${kind}`}>
    <div class="hub-intro"><header class="page-intro"><span class="page-kicker">{kicker}</span><h1>{heading}</h1><p>{intro}</p></header><div class="hub-index" aria-hidden="true"><span class="hub-index-mark">{index}</span><span class="hub-index-copy">{indexLabel}</span></div></div>
    <section class="hub-feature" aria-labelledby="hub-feature-title"><div><div class="eyebrow">THE EDITORIAL APPROACH</div><h2 id="hub-feature-title">{featureTitle}</h2><p>{featureCopy}</p></div><p class="hub-feature-aside">{featureAside}</p></section>
    <HubVisual kind={kind} />
    {articles.length > 0 && <section class="hub-catalog hub-published" aria-labelledby="published-title"><div class="hub-catalog-heading"><h2 id="published-title">Published resources</h2><p>{kind === 'guides' ? 'A practical Windows walkthrough, sourced and ready to follow.' : 'Practical resources, sourced and ready to use.'}</p></div><div class="hub-grid">{articles.map((article) => <ResourceCard title={article.data.title} description={article.data.summary} category={article.data.section === 'learn' ? 'Learn · field note' : article.data.section === 'guides' ? 'Guides · Windows setup' : 'Troubleshoot · diagnostic'} icon={article.data.visual === 'setup' ? 'steps' : article.data.visual === 'memory' ? 'hardDrives' : article.data.visual === 'threads' ? 'cpu' : article.data.visual === 'huge-pages' ? 'memory' : article.data.visual === 'msr' ? 'lockKey' : 'gauge'} href={`/${article.data.section}/${article.id}/`} />)}</div></section>}
    <section class="hub-catalog" aria-labelledby="hub-catalog-title"><div class="hub-catalog-heading"><h2 id="hub-catalog-title">{kind === 'guides' && articles.length > 0 ? 'More guide themes' : cardsTitle}</h2><p>{kind === 'tools' ? 'Three tools are available now; the remaining concepts are planned.' : kind === 'guides' && articles.length > 0 ? 'Other task paths remain planned until their steps are independently verified.' : 'Topic areas for the first editorial collection.'}</p></div>
      <div class="hub-grid">{cards.map((card) => <ResourceCard {...card} status={card.status ?? 'Planned'} />)}</div>
      <p class="hub-footnote"><span aria-hidden="true">↳</span><span>{note}</span></p>
    </section>
  </div>
</SiteLayout>
