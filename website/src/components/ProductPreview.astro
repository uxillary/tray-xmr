---
import Icon from './Icon.astro';
---
<figure class="product-visual" aria-labelledby="product-preview-caption">
  <div class="visual-orbit" aria-hidden="true"></div>
  <div class="product-window">
    <div class="window-top"><div class="window-lights" aria-hidden="true"><span></span><span></span><span></span></div><span>EMBER / MINING SETUP</span><span>LOCAL</span></div>
    <div class="window-app">
      <aside class="window-rail" aria-hidden="true"><span class="rail-active"><Icon name="gauge" size="inline" /></span><span><Icon name="bookOpenText" size="inline" /></span><span><Icon name="network" size="inline" /></span><span><Icon name="gear" size="inline" /></span></aside>
      <div class="window-content">
        <div class="mock-topline"><div><span class="readout-label">SESSION CONTROL</span><strong class="mock-title">Your setup</strong></div><span class="demo-tag">INTERFACE STUDY</span></div>
        <div class="mock-state"><div><span class="readout-label">MINING STATE</span><div class="state-value"><span class="status-dot" aria-hidden="true"></span>Stopped</div></div><span class="state-aside">START IS EXPLICIT</span></div>
        <div class="preview-rows">
          <div class="preview-row"><span class="row-icon" aria-hidden="true">01</span><span><small>MINING ENGINE</small><strong>XMRig · verified install</strong></span><span class="row-state">READY</span></div>
          <div class="preview-row"><span class="row-icon" aria-hidden="true">02</span><span><small>POOL</small><strong>Manually configured</strong></span><span class="row-state row-state-muted">SETUP</span></div>
          <div class="preview-row"><span class="row-icon" aria-hidden="true">03</span><span><small>CPU PROFILE</small><strong>Balanced · thread profile</strong></span><span class="capacity-line" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
        </div>
        <div class="preview-footer"><span><i class="local-mark" aria-hidden="true"></i>LOCAL SESSION</span><span>NO LIVE MINING DATA</span></div>
      </div>
    </div>
  </div>
  <figcaption id="product-preview-caption"><span>EMBER DESKTOP / PRODUCT PREVIEW</span><span>Illustrative setup · no live user data</span></figcaption>
</figure>
