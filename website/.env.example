# Local development defaults to http://localhost:4321; no setting is required.
# Release builds require SITE_URL to be explicitly set to the confirmed HTTPS origin.
# SITE_URL=https://your-confirmed-domain.invalid

# Local and preview builds default to noindex. Set index ONLY in Production,
# alongside the owner-confirmed public SITE_URL. Synthetic origins cannot be indexed.
SITE_INDEXING=noindex
